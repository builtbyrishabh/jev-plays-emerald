# Vercel AI Gateway credential for typesafe-ai/jev
AI_GATEWAY_API_KEY=
# Default mission: first-gym. Use rival to reproduce opening-only benchmarks.
# JEV_TARGET=first-gym
# Optional: adds occasional LLM recovery advice.
# Also enables the TypeScript decision service (cd service && pnpm install).
# Billed through the same gateway key as Jev.
# JEV_PLANNER_MODEL=openai/gpt-5.6-luna
